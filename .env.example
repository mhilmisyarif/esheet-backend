# ── esheet-backend environment ──────────────────────────────────────────────
# Copy to ".env" and fill in real values. Never commit the real .env.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (contains DB credentials — keep secret).
DATABASE_URL="postgresql://user:password@localhost:5432/esheet_db?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign JWT auth tokens.
# Use a long, random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-secret"

# JWT session lifetime (jsonwebtoken syntax: "8h", "24h", "7d").
# Default 24h when unset. Shorter = more secure, users re-login more often.
JWT_EXPIRES_IN=24h

# ── Server ──────────────────────────────────────────────────────────────────
# Port the API server listens on (default 5000 when unset).
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Leave empty in development to allow all origins.
# Production example: CORS_ORIGINS=https://esheet.your-domain.com
CORS_ORIGINS=

# ── Seed accounts (prisma/seed.js) ──────────────────────────────────────────
# Passwords for the seeded demo/bootstrap accounts. REQUIRED before running
# `npx prisma db seed` on any shared server; change them after first login.
ADMIN_SEED_PASSWORD="change-me-admin"
SEED_USER_PASSWORD="change-me-users"

# ── Datasheet PDF document control (footer) ─────────────────────────────────
# Fallbacks when a TestStandard has no form_code of its own, plus the shared
# revision + effective-date strip printed on every page.
DATASHEET_FORM_NO=FOR/LAB-CHY/09
DATASHEET_REV=Rev.01
DATASHEET_EFFECTIVE=18/12/2023

// This is your Prisma schema file,
// located at prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- AUTH (Q5) ---
enum UserRole {
  TECHNICIAN
  ENGINEER
  DRAFTER        // NEW — view + download Draft + fill document metadata
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          UserRole @default(TECHNICIAN)

  // Relations
  ReportsAsTechnician Report[] @relation("TechnicianReports")
  ReportsAsEngineer   Report[] @relation("EngineerReports")
  CreatedTemplates  TableTemplate[]  @relation("TemplateCreator")
  KlausulsSubmitted  KlausulStatus[] @relation("KlausulSubmitter")
  KlausulsApproved   KlausulStatus[] @relation("KlausulApprover")

  HistoryLogs         ReportHistory[]
}

// --- LABS & STANDARDS (Q2) ---
model Lab {
  id       Int      @id @default(autoincrement())
  lab_code String   @unique // e.g., "01", "04"
  name     String

  // Relations
  TestStandards TestStandard[]
  Orders        Order[]
}

model TestStandard {
  id            Int    @id @default(autoincrement())
  name          String @unique // e.g., "Lampu LED Swa-Balast"

  standard_numbers String[]  // e.g. "SNI IEC 62560:2015"
  updatedAt       DateTime @default(now()) @updatedAt // Automatically tracks last edit

  lab           Lab    @relation(fields: [labId], references: [id])
  labId         Int

  // The JSON template!
  template_data Json

  // Relations
  Samples Sample[]
  TableTemplates  TableTemplate[]
}

// --- WORKFLOW ---
model Order {
  id        Int      @id @default(autoincrement())
  order_no  String   @unique
  lab       Lab      @relation(fields: [labId], references: [id])
  labId     Int
  applicant String?
  address   String?
  createdAt DateTime @default(now())

  // Relations
  Samples Sample[]
}

model Sample {
  id             Int      @id @default(autoincrement())
  order          Order    @relation(fields: [orderId], references: [id])
  orderId        Int
  testStandard   TestStandard @relation(fields: [testStandardId], references: [id])
  testStandardId Int

  iwo_no String? // Optional IWO
  name   String
  brand  String
  model  String

  factory         String? // Manufacturer name
  factory_address String? // Manufacturer address
  country_origin  String? // Country of manufacture

  // Relations
  Report     Report?     // A sample has one report
  Components  Component[] // Tested components recorded for this sample
}

// Components tested as part of a sample (shown on the Datasheet Detail page)
model Component {
  id          Int      @id @default(autoincrement())
  sample      Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  sampleId    Int

  objek       String   // Objek / part No.
  pabrikan    String?  // Pabrikan / merk dagang
  tipe        String?  // Tipe / model
  data_teknis String?  // Data teknis
  standar     String?  // Standar
  tanda       String?  // Tanda sertifikasi

  createdAt   DateTime @default(now())
}

// --- THE E-SHEET (HYBRID MODEL) ---
enum ReportStatus {
  DRAFT          // no klausul submitted yet, or mix of draft/submitted/approved
  IN_PROGRESS    // at least one klausul submitted, others still draft
  APPROVED       // all klausuls approved
}

enum KlausulStatusEnum {
  DRAFT
  SUBMITTED
  APPROVED
}

enum TestingType {
  FULL
  VERIFICATION
}

model Report {
  id               Int           @id @default(autoincrement())
  sample           Sample        @relation(fields: [sampleId], references: [id])
  sampleId         Int           @unique

  technician       User?         @relation("TechnicianReports", fields: [technicianId], references: [id])
  technicianId     Int?
  engineer         User?         @relation("EngineerReports", fields: [engineerId], references: [id])
  engineerId       Int?

  status           ReportStatus  @default(DRAFT)
  testing_type     TestingType   @default(FULL)
  
  data             Json
  // document metadata — filled by Drafter before download
  doc_applicant    String?
  doc_address      String?
  doc_standard     String?
  doc_location     String?       @default("Laboratorium PT. SUCOFINDO")
  doc_notes        String?
  approved_at      DateTime?     // set when ALL klausuls are approved
  createdAt        DateTime      @default(now())

  ReportHistory    ReportHistory[]
  ReportImages     ReportImage[]
  TableInstances   TableInstance[]
  KlausulStatuses  KlausulStatus[]
  ClauseTables     ClauseTable[]
}


model KlausulStatus {
  id           Int               @id @default(autoincrement())

  report       Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId     Int

  klausulCode  String            // e.g. "6", "6.1" — matches klausul.klausul in report.data

  status       KlausulStatusEnum @default(DRAFT)

  // Who submitted this klausul
  submittedBy  User?             @relation("KlausulSubmitter", fields: [submittedById], references: [id])
  submittedById Int?
  submittedAt  DateTime?

  // Who approved this klausul + what corrections were made
  approvedBy   User?             @relation("KlausulApprover", fields: [approvedById], references: [id])
  approvedById Int?
  approvedAt   DateTime?
  corrections  String?           // engineer's correction notes, if any

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([reportId, klausulCode])  // one status row per klausul per report
  @@index([reportId])
}

model ReportImage {
  id        Int      @id @default(autoincrement())
  report    Report   @relation(fields: [reportId], references: [id])
  reportId  Int

  url       String   // The path to the file, e.g., /uploads/image-123.png
  caption   String?  // The caption entered by the user
  category  String   @default("SAMPLE") // "SAMPLE" gallery or "COMPONENT" gallery

  createdAt DateTime @default(now())
}

model ClauseTable {
  id          Int      @id @default(autoincrement())
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId    Int

  clauseCode  String   // e.g. "6.1" — matches klausul.kode in report.data JSON
  title       String   @default("")
  headers     String[] // column headers e.g. ["Kode Sampel", "01", "02", ...]
  rows        Json     // String[][] — each row is an array of cell values
  notes       String   @default("")
  order       Int      @default(0) // sort order within a clause

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TableTemplate {
  id             Int          @id @default(autoincrement())

  testStandard   TestStandard @relation(fields: [testStandardId], references: [id], onDelete: Cascade)
  testStandardId Int

  subClauseCode  String       // e.g. "6.1", "12" — matches sub_klausul.kode in report.data
  title          String       @default("")
  order          Int          @default(0)

  // Full structural definition as JSON — see structure docs below
  definition     Json

  createdBy      User         @relation("TemplateCreator", fields: [createdById], references: [id])
  createdById    Int

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  instances      TableInstance[]

  @@index([testStandardId, subClauseCode])
}

model TableInstance {
  id          Int           @id @default(autoincrement())

  report      Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId    Int

  template    TableTemplate @relation(fields: [templateId], references: [id])
  templateId  Int

  // Only the cell VALUES are stored here — structure comes from template.definition
  // Shape: { rows: [ { rowId: string, cells: { colId: value } } ] }
  // For key_value sections: { kv: { rowId: { value, result } } }
  data        Json          @default("{}")

  order       Int           @default(0)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([reportId, templateId])
}

